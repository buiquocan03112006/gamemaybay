<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 768 800" width="768" height="800" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="wingG" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#78849f"/>
      <stop offset="0.45" stop-color="#3a4053"/>
      <stop offset="1" stop-color="#171a23"/>
    </linearGradient>
    <linearGradient id="plateG" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#9aa6bd"/>
      <stop offset="1" stop-color="#4b5369"/>
    </linearGradient>
    <linearGradient id="hullG" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#1c202a"/>
      <stop offset="0.3" stop-color="#5f6b84"/>
      <stop offset="0.5" stop-color="#a3aec4"/>
      <stop offset="0.7" stop-color="#5f6b84"/>
      <stop offset="1" stop-color="#1c202a"/>
    </linearGradient>
    <linearGradient id="dorsalG" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#3d4458"/>
      <stop offset="0.5" stop-color="#c3cddf"/>
      <stop offset="1" stop-color="#3d4458"/>
    </linearGradient>
    <linearGradient id="redG" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff5a66"/>
      <stop offset="1" stop-color="#8f0c1c"/>
    </linearGradient>
    <linearGradient id="visorG" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff6a6a"/>
      <stop offset="1" stop-color="#9c0014"/>
    </linearGradient>
    <radialGradient id="coreG">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="0.3" stop-color="#ffe066"/>
      <stop offset="0.65" stop-color="#ff7a12"/>
      <stop offset="1" stop-color="#a81c0a"/>
    </radialGradient>
    <radialGradient id="glowG">
      <stop offset="0" stop-color="#ff9a2a" stop-opacity="0.85"/>
      <stop offset="0.5" stop-color="#ff5a1a" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#ff3a1a" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="flameG" cx="0.5" cy="1" r="1" fx="0.5" fy="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="0.3" stop-color="#8fe3ff"/>
      <stop offset="0.65" stop-color="#2f7bff" stop-opacity="0.8"/>
      <stop offset="1" stop-color="#2f7bff" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="muzzleG">
      <stop offset="0" stop-color="#fff6c0"/>
      <stop offset="0.4" stop-color="#ffa41f"/>
      <stop offset="1" stop-color="#ff5a00" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="podG" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#0f1116"/>
      <stop offset="0.5" stop-color="#4a5266"/>
      <stop offset="1" stop-color="#0f1116"/>
    </linearGradient>

    <!-- nửa trái, được lật để tạo nửa phải -->
    <g id="half">
      <!-- cánh đuôi sau -->
      <polygon points="345,95 262,40 205,62 262,140 345,175" fill="url(#wingG)" stroke="#0b0d12" stroke-width="4" stroke-linejoin="round"/>
      <polygon points="330,110 268,68 240,80 275,130 330,155" fill="#c9182b" opacity="0.85"/>

      <!-- lửa động cơ cánh -->
      <ellipse cx="210" cy="165" rx="30" ry="78" fill="url(#flameG)"/>
      <ellipse cx="128" cy="150" rx="22" ry="60" fill="url(#flameG)"/>

      <!-- cánh chính -->
      <polygon points="335,512 180,422 45,292 30,195 85,207 120,165 165,227 215,197 265,257 335,272"
               fill="url(#wingG)" stroke="#0b0d12" stroke-width="5" stroke-linejoin="round"/>
      <!-- tấm giáp trong -->
      <polygon points="322,472 194,398 92,296 82,236 130,258 172,302 232,300 322,342"
               fill="url(#plateG)" stroke="#0b0d12" stroke-width="4" stroke-linejoin="round"/>
      <!-- vạch đỏ neon -->
      <polygon points="316,452 204,390 112,300 106,268 140,282 176,318 232,318 316,362"
               fill="url(#redG)" stroke="#40060c" stroke-width="3" stroke-linejoin="round"/>
      <polygon points="300,440 214,390 140,318 236,340 300,388" fill="#0b0d12" opacity="0.35"/>

      <!-- đường panel -->
      <g stroke="#0b0d12" stroke-width="2.5" fill="none" opacity="0.8">
        <path d="M250 300 L250 380"/>
        <path d="M290 315 L290 425"/>
        <path d="M170 302 L150 380"/>
      </g>
      <!-- viền sáng mép trước -->
      <polyline points="335,512 180,422 45,292 30,195" fill="none" stroke="#c7d2e6" stroke-width="3" opacity="0.7" stroke-linejoin="round"/>
      <!-- đinh tán -->
      <g fill="#cfd8ea" opacity="0.75">
        <circle cx="300" cy="300" r="3.5"/><circle cx="270" cy="285" r="3.5"/>
        <circle cx="240" cy="270" r="3.5"/><circle cx="118" cy="230" r="3.5"/>
      </g>

      <!-- vòi động cơ -->
      <path d="M190 190 L232 190 L226 226 L196 226 Z" fill="#161a22" stroke="#000" stroke-width="3"/>
      <rect x="192" y="196" width="36" height="6" fill="#4a5266"/>
      <path d="M108 160 L148 160 L143 194 L113 194 Z" fill="#161a22" stroke="#000" stroke-width="3"/>

      <!-- pod pháo ngoài -->
      <rect x="96" y="325" width="30" height="118" rx="7" fill="url(#podG)" stroke="#000" stroke-width="3"/>
      <rect x="93" y="425" width="36" height="22" rx="4" fill="#c9182b" stroke="#000" stroke-width="3"/>
      <rect x="107" y="440" width="8" height="18" fill="#000"/>
      <circle cx="111" cy="462" r="20" fill="url(#muzzleG)"/>
      <!-- pod pháo trong -->
      <rect x="197" y="335" width="32" height="150" rx="7" fill="url(#podG)" stroke="#000" stroke-width="3"/>
      <rect x="194" y="465" width="38" height="24" rx="4" fill="#c9182b" stroke="#000" stroke-width="3"/>
      <rect x="209" y="482" width="8" height="18" fill="#000"/>
      <circle cx="213" cy="505" r="22" fill="url(#muzzleG)"/>
    </g>
  </defs>

  <g transform="translate(0,40)">
    <!-- ánh sáng lõi -->
    <circle cx="384" cy="330" r="150" fill="url(#glowG)"/>

    <!-- lửa động cơ trung tâm -->
    <ellipse cx="384" cy="70" rx="46" ry="90" fill="url(#flameG)"/>

    <use href="#half"/>
    <use href="#half" transform="translate(768,0) scale(-1,1)"/>

    <!-- thân chính -->
    <path d="M384 55 L432 92 L464 172 L474 302 L456 462 L420 602 L384 694 L348 602 L312 462 L294 302 L304 172 L336 92 Z"
          fill="url(#hullG)" stroke="#0b0d12" stroke-width="5" stroke-linejoin="round"/>
    <!-- giáp lưng -->
    <path d="M384 112 L422 172 L432 302 L418 440 L384 522 L350 440 L336 302 L346 172 Z"
          fill="url(#dorsalG)" stroke="#0b0d12" stroke-width="3.5" stroke-linejoin="round"/>
    <!-- đường panel thân -->
    <g stroke="#0b0d12" stroke-width="2.5" fill="none" opacity="0.75">
      <path d="M350 205 L418 205"/>
      <path d="M340 255 L428 255"/>
      <path d="M340 415 L428 415"/>
      <path d="M356 470 L412 470"/>
      <path d="M384 112 L384 190"/>
    </g>
    <!-- sọc đỏ bên hông -->
    <polygon points="306,190 336,200 340,300 300,290" fill="url(#redG)" stroke="#40060c" stroke-width="3"/>
    <polygon points="462,190 432,200 428,300 468,290" fill="url(#redG)" stroke="#40060c" stroke-width="3"/>

    <!-- vòm tản nhiệt sau -->
    <rect x="356" y="72" width="56" height="34" rx="6" fill="#151820" stroke="#000" stroke-width="3"/>
    <g stroke="#4a5266" stroke-width="3"><path d="M364 80 L364 100"/><path d="M374 80 L374 100"/><path d="M384 80 L384 100"/><path d="M394 80 L394 100"/><path d="M404 80 L404 100"/></g>

    <!-- lõi năng lượng -->
    <polygon points="384,272 422,294 422,338 384,360 346,338 346,294" fill="#12151c" stroke="#000" stroke-width="4"/>
    <circle cx="384" cy="316" r="40" fill="#1d2230" stroke="#c9182b" stroke-width="5"/>
    <circle cx="384" cy="316" r="30" fill="url(#coreG)"/>
    <circle cx="374" cy="306" r="8" fill="#fff" opacity="0.7"/>
    <g stroke="#0b0d12" stroke-width="3"><path d="M384 276 L384 286"/><path d="M384 346 L384 356"/><path d="M344 316 L354 316"/><path d="M414 316 L424 316"/></g>

    <!-- kính mắt -->
    <path d="M334 532 L384 510 L434 532 L416 584 L384 598 L352 584 Z" fill="#12151c" stroke="#000" stroke-width="4" stroke-linejoin="round"/>
    <path d="M346 536 L384 520 L422 536 L408 574 L384 584 L360 574 Z" fill="url(#visorG)"/>
    <path d="M356 540 L384 530 L412 540 L384 550 Z" fill="#fff" opacity="0.35"/>

    <!-- càng mũi -->
    <path d="M350 592 L318 650 L332 740 L368 660 Z" fill="url(#wingG)" stroke="#0b0d12" stroke-width="4" stroke-linejoin="round"/>
    <path d="M418 592 L450 650 L436 740 L400 660 Z" fill="url(#wingG)" stroke="#0b0d12" stroke-width="4" stroke-linejoin="round"/>
    <path d="M336 690 L332 740 L352 700 Z" fill="#c9182b"/>
    <path d="M432 690 L436 740 L416 700 Z" fill="#c9182b"/>
    <!-- pháo mũi -->
    <rect x="372" y="628" width="24" height="86" rx="6" fill="url(#podG)" stroke="#000" stroke-width="3"/>
    <circle cx="384" cy="722" r="26" fill="url(#muzzleG)"/>
    <!-- viền sáng thân -->
    <polyline points="304,172 294,302 312,462 348,602 384,694" fill="none" stroke="#dbe4f5" stroke-width="2.5" opacity="0.5"/>
  </g>
</svg>
